# Tic-Tac-Toe Tournament Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_HOST=localhost
DB_NAME=tic_tac_toe_tournament
DB_USER=your_db_username
DB_PASS=your_db_password

# Application Settings
APP_ENV=production
APP_URL=https://yourdomain.com
TIMEZONE=Asia/Kolkata

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Kukupay Payment Gateway
KUKUPAY_API_KEY=your_kukupay_api_key_here
KUKUPAY_API_URL=https://api.kukupay.com/v1/

# Admin Configuration
ADMIN_EMAIL=admin@yourdomain.com

# UPI Configuration (comma-separated list)
UPI_IDS=admin@paytm,admin@phonepe,admin@gpay

# Security Settings
SESSION_SECURE=true
SESSION_HTTPONLY=true

# File Upload Settings
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png

# Game Settings
MOVE_TIMEOUT=15
MIN_WITHDRAWAL=50.00
MAX_WITHDRAWAL=10000.00
REFERRAL_BONUS=5.00
TOURNAMENT_COMMISSION=10.00

# Logging
LOG_LEVEL=ERROR
LOG_FILE=/home/username/public_html/logs/app.log